# ---- Target ----
CONFIG_IDF_TARGET="esp32s3"

# ---- Flash: 16MB external (Winbond W25Q128) ----
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# ---- PSRAM: 8MB OCTAL (the "R8" in ESP32-S3R8) ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# ---- CPU at full 240 MHz ----
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ---- Custom partition table (app + speech-model partition for Phase 2) ----
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- HTTPS to Wikipedia: use the bundled CA roots so TLS just works ----
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_ESP_TLS_INSECURE=n

# ---- Give the main task room (TLS + JSON + LVGL calls) ----
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288

# ---- LVGL color depth 16 (RGB565) to match the ST7789 ----
CONFIG_LV_COLOR_DEPTH_16=y
# ---- PNG decoder (for Wikipedia lead images that are PNG) ----
CONFIG_LV_USE_LODEPNG=y

# ---- ESP-SR on-device speech (Phase 2) ----
# Models live in the 'model' flash partition.
CONFIG_MODEL_IN_FLASH=y
# Push-to-talk: no wake word needed, so don't waste flash on a wake-word model.
CONFIG_USE_WAKENET=n
# We only want the English command model.
CONFIG_SR_MN_CN_NONE=y
CONFIG_SR_MN_EN_MULTINET7_QUANT=y
